OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# 0: text only; 1-10: maximum photos per listing.
TELEGRAM_MAX_PHOTOS=3
POLL_SECONDS=600
SOLO_CHEAP_MAX_RENT_KC=13500
# Optional strict total limit, applied only when rent and utilities are known.
# Leave commented out to disable.
# SOLO_CHEAP_MAX_RENT_AND_UTILITIES_KC=17000
# #duo_cheap: 2+1, 3+kk and larger; strict limits (20001 means up to 20,000 Kč inclusive).
DUO_CHEAP_MAX_RENT_KC=20001
DUO_CHEAP_MAX_RENT_AND_UTILITIES_KC=25001
DISTRICT_ID=72
DATA_DIR=data
# false: first successful scan records existing ads without Telegram spam.
# true: send every matching ad on the first scan too.
NOTIFY_EXISTING=false
